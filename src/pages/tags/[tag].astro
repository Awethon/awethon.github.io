---
import Base from '../../layouts/Base.astro'
import PostCard from '../../components/PostCard.astro'
import { allPosts, allTags, postHref, readingMinutes } from '../../lib/posts'

export async function getStaticPaths() {
  const tags = await allTags()
  const posts = await allPosts()
  return tags.map((entry) => ({
    params: { tag: entry.slug },
    props: {
      label: entry.tag,
      posts: posts.filter((post) => post.data.tags.includes(entry.tag)),
    },
  }))
}

const { label, posts } = Astro.props
---

<Base title={`Tagged ${label}`}>
  <section class="wrap">
    <p class="kicker">Tagged</p>
    <h1>{label}</h1>
    {
      posts.map((post) => (
        <PostCard
          href={postHref(post)}
          title={post.data.title}
          date={post.data.date}
          tags={post.data.tags}
          minutes={readingMinutes(post.body)}
        />
      ))
    }
  </section>
</Base>

<style>
  .kicker {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--accent);
    margin: 0;
    padding-block-start: clamp(2.5rem, 8vh, 4rem);
  }

  h1 {
    font-size: var(--step-4);
    padding-block: 0.3rem 1rem;
    border-block-end: 1px solid var(--border);
  }
</style>
