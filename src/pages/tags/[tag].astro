---
import Base from '../../layouts/Base.astro'
import PostCard from '../../components/PostCard.astro'
import { allPosts, allTags, postHref, readingMinutes } from '../../lib/posts'

export async function getStaticPaths() {
  const tags = await allTags()
  const posts = await allPosts()
  return tags.map((entry) => ({
    params: { tag: entry.slug },
    props: {
      label: entry.tag,
      posts: posts.filter((post) => post.data.tags.includes(entry.tag)),
    },
  }))
}

const { label, posts } = Astro.props
---

<Base title={`Tagged ${label}`}>
  <section class="wrap">
    <p class="kicker">Tagged</p>
    <h1>{label}</h1>
    <div class="list">
      {
        posts.map((post) => (
          <PostCard
            href={postHref(post)}
            title={post.data.title}
            date={post.data.date}
            tags={post.data.tags}
            minutes={readingMinutes(post.body)}
          />
        ))
      }
    </div>
  </section>
</Base>

<style>
  .kicker {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
    text-align: center;
    margin: 0;
    padding-block-start: clamp(2.5rem, 8vh, 4rem);
  }

  h1 {
    font-size: var(--step-4);
    text-align: center;
    padding-block: 0.5rem 1.75rem;
  }
</style>
