---
import Base from '../../layouts/Base.astro'
import { allTags } from '../../lib/posts'

const tags = await allTags()
---

<Base title="Tags">
  <section class="wrap">
    <h1>Tags</h1>
    <ul>
      {
        tags.map((entry) => (
          <li>
            <a href={`/tags/${entry.slug}/`}>
              {entry.tag} <span>{entry.count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  h1 {
    font-size: var(--step-4);
    padding-block: clamp(2.5rem, 8vh, 4rem) 1rem;
    border-block-end: 1px solid var(--border);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    list-style: none;
    margin: 2rem 0;
    padding: 0;
  }

  a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-decoration: none;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.35rem 0.9rem;
    transition: border-color 0.18s ease, color 0.18s ease;
  }

  a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  span {
    color: var(--ink-muted);
    font-size: 0.75rem;
  }
</style>
