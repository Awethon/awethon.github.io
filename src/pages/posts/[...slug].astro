---
import { render } from 'astro:content'
import Base from '../../layouts/Base.astro'
import { allPosts, postHref, readingMinutes } from '../../lib/posts'

export async function getStaticPaths() {
  const posts = await allPosts()
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props
const { Content, headings } = await render(post)
const minutes = readingMinutes(post.body)
const published = post.data.date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
})
const updated = post.data.modified?.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
})
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3)
const transitionName = `post-${postHref(post).replace(/\W+/g, '-')}`
---

<Base title={post.data.title} description={post.data.summary} progress>
  <article class="prose">
    <header>
      <p class="meta">
        <time datetime={post.data.date.toISOString().slice(0, 10)}>{published}</time>
        <span>&middot;</span>
        <span>{minutes} min read</span>
        {updated && <><span>&middot;</span><span>updated {updated}</span></>}
      </p>
      <h1 style={`view-transition-name: ${transitionName}`}>{post.data.title}</h1>
      {
        post.data.tags.length > 0 && (
          <ul class="tags">
            {post.data.tags.map((tag) => (
              <li>
                <a href={`/tags/${tag.toLowerCase().replace(/\s+/g, '-')}/`}>{tag}</a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    {
      toc.length > 2 && (
        <nav class="toc" aria-label="Table of contents">
          <p class="toc-title">Contents</p>
          <ol>
            {toc.map((heading) => (
              <li data-depth={heading.depth}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <Content />

    <footer>
      <a class="back" href="/posts/">&larr; All posts</a>
      <a
        class="edit"
        href={`https://github.com/Awethon/awethon.github.io/blob/master/src/content/posts/${post.id}`}
        >Suggest changes</a
      >
    </footer>
  </article>
</Base>

<style>
  header {
    padding-block: clamp(2.5rem, 8vh, 4.5rem) 1.5rem;
  }

  h1 {
    font-size: var(--step-4);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-muted);
    margin: 0 0 0.9rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 1.2rem 0 0;
    padding: 0;
  }

  .tags a {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.12rem 0.62rem;
    text-decoration: none;
  }

  .tags a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .toc {
    margin-block: 1rem 2.5rem;
    padding: 1rem 1.2rem;
    border-inline-start: 2px solid var(--border);
    background: color-mix(in oklch, var(--surface) 55%, transparent);
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  .toc-title {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 0 0 0.6rem;
  }

  .toc ol {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.3rem;
    font-size: var(--step--1);
  }

  .toc li[data-depth='3'] {
    padding-inline-start: 1.1rem;
  }

  .toc a {
    text-decoration: none;
    color: var(--ink-muted);
  }

  .toc a:hover {
    color: var(--accent);
  }

  footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-block-start: 4rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  footer a {
    text-decoration: none;
    color: var(--ink-muted);
  }

  footer a:hover {
    color: var(--accent);
  }
</style>
