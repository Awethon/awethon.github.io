---
import Base from '../layouts/Base.astro'
import PostCard from '../components/PostCard.astro'
import { allPosts, postHref, readingMinutes } from '../lib/posts'

const posts = (await allPosts()).slice(0, 5)
const socials = [
  { href: 'https://github.com/awethon/', label: 'GitHub' },
  { href: 'https://linkedin.com/in/awethon/', label: 'LinkedIn' },
  { href: 'https://telegram.me/awethon/', label: 'Telegram' },
  { href: 'mailto:awethon@gmail.com', label: 'Email' },
]
---

<Base>
  <section class="hero wrap">
    <p class="kicker">Aleksey Polovinkin</p>
    <h1>
      Scala developer and <em>functional programming</em> enthusiast.
    </h1>
    <p class="lede">
      I write about JVM tooling, type systems, and the ways teams trade clarity for cleverness.
      Currently building scheduling infrastructure and wanting to be a principal engineer.
    </p>
    <ul class="socials">
      {socials.map((social) => <li><a href={social.href}>{social.label}</a></li>)}
    </ul>
  </section>

  <section class="wrap feed">
    <h2 class="rubric">Writing</h2>
    {
      posts.map((post) => (
        <PostCard
          href={postHref(post)}
          title={post.data.title}
          date={post.data.date}
          tags={post.data.tags}
          minutes={readingMinutes(post.body)}
        />
      ))
    }
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(3.5rem, 11vh, 7rem) clamp(2.5rem, 7vh, 4.5rem);
  }

  .kicker {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--accent);
    margin: 0 0 1rem;
    letter-spacing: 0.02em;
  }

  h1 {
    font-size: var(--step-5);
    margin: 0;
    max-inline-size: 19ch;
  }

  h1 em {
    font-style: italic;
    font-variation-settings: 'SOFT' 80, 'WONK' 1;
    color: var(--accent);
  }

  .lede {
    max-inline-size: 56ch;
    margin-block: 1.6rem 0;
    color: var(--ink-muted);
    font-size: var(--step-1);
    line-height: 1.55;
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.4rem;
    list-style: none;
    margin: 2.2rem 0 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .rubric {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
    border-block-end: 1px solid var(--border);
    padding-block-end: 0.8rem;
    margin: 0;
  }

  .feed {
    padding-block-end: 2rem;
  }
</style>
