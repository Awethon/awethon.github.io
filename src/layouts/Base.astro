---
import { ClientRouter } from 'astro:transitions'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Aurora from '../components/Aurora.astro'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  progress?: boolean
  dim?: boolean
}

const {
  title,
  description = 'Scala developer and functional programming enthusiast. Notes on JVM tooling, type systems and remote work.',
  progress = false,
  dim = false,
} = Astro.props

const pageTitle = title ? `${title} — Awethon` : "Awethon's Page"
const canonical = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="qgixNnkm2LoCsgWFtvfJRVqnkpqtr1Xzc5YTPoCL2zc" />
    <meta name="yandex-verification" content="c25e903254c44b74" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <ClientRouter />
  </head>
  <body class={dim ? 'dim' : undefined}>
    <Aurora transition:persist="aurora" />
    {progress && <div class="progress"></div>}
    <div class="shell">
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
