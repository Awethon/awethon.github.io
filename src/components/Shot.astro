---
// One picture or silent looping video in a post. Without a src it renders a labelled placeholder
// describing the shot that still has to be captured.
interface Props {
  src?: string
  alt: string
  caption?: string
  video?: boolean
  phone?: boolean
  planned?: string
  poster?: string
}

const { src, alt, caption, video = false, phone = false, planned, poster } = Astro.props
---

<figure class:list={['shot', { phone }]}>
  {
    src ? (
      video ? (
        <video src={src} poster={poster} aria-label={alt} autoplay muted loop playsinline preload="metadata" />
      ) : (
        <img src={src} alt={alt} loading="lazy" decoding="async" />
      )
    ) : (
      <div class="planned" role="img" aria-label={alt}>
        <span class="kind">{video ? 'Video' : 'Screenshot'}{phone ? ' · phone' : ''}</span>
        <span>{planned ?? alt}</span>
      </div>
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .shot {
    margin: 0;
    flex: 1 1 0;
    min-width: 0;
  }
  .shot.phone {
    flex: 0 0 min(32%, 15rem);
  }
  img,
  video {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }
  .planned {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.5em;
    aspect-ratio: 16 / 10;
    padding: 1.25em;
    border-radius: var(--radius);
    border: 1px dashed var(--border-strong);
    background: var(--surface);
    color: var(--ink-muted);
    font-size: 0.85em;
    line-height: 1.45;
  }
  .phone .planned {
    aspect-ratio: 9 / 19.5;
  }
  .kind {
    color: var(--accent);
    font-size: 0.8em;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  figcaption {
    margin-top: 0.6em;
    color: var(--ink-muted);
    font-size: 0.85em;
    text-align: center;
  }
</style>
