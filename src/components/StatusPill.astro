---
interface Props {
  label?: string
}

const { label = 'Working at Chili Piper' } = Astro.props
---

<p class="status"><b></b>{label}</p>

<style>
  .status {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin: 0;
    font-family: var(--font-ui);
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0.005em;
    line-height: 1;
    color: #c9cfdb;
    padding: 8px 15px 8px 13px;
    border-radius: 999px;
    white-space: nowrap;
    background: rgba(8, 9, 12, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.1);
    -webkit-backdrop-filter: blur(26px) saturate(170%) brightness(0.42);
    backdrop-filter: blur(26px) saturate(170%) brightness(0.42);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.08) inset,
      0 12px 28px -18px rgba(0, 0, 0, 0.72);
  }

  .status b {
    position: relative;
    inline-size: 6px;
    block-size: 6px;
    border-radius: 50%;
    flex: none;
    background: var(--accent-2);
    box-shadow: 0 0 8px var(--accent-2), 0 0 16px rgba(127, 214, 208, 0.45);
    animation: beam-core 2s ease-in-out infinite;
  }

  .status b::after {
    content: '';
    position: absolute;
    inset: -5px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(127, 214, 208, 0.5), rgba(127, 214, 208, 0) 70%);
    animation: beam-halo 2s ease-in-out infinite;
  }

  @keyframes beam-core {
    0%, 100% { opacity: 0.72; }
    50% { opacity: 1; }
  }

  @keyframes beam-halo {
    0%, 100% { transform: scale(0.65); opacity: 0.28; }
    50% { transform: scale(1.3); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .status b,
    .status b::after {
      animation: none;
    }
  }
</style>
