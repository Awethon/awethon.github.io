    margin-block-start: 5rem;
    border-block-start: 1px solid var(--border);
    padding-block: 2rem;
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    justify-content: space-between;
  }

  .built {
    font-family: var(--font-mono);
  }
</style>
